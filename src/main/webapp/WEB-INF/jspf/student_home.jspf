                           <div class="tab-content rounded-bottom">
    <div class="tab-pane p-3 active preview" role="tabpanel" id="preview-1000">
        <div class="accordion" id="accordionExample">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-coreui-toggle="collapse" data-coreui-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">Personal Details</button>
                </h2>
                <div class="accordion-collapse collapse show" id="collapseOne" aria-labelledby="headingOne" data-coreui-parent="#accordionExample" style="">
                    <div class="accordion-body">
                        <%
                            try {
                        %>
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <th>Registration Number</th>
                                    <td><%=std.getMatricNo() == null ? std.getRegistrationNo().toUpperCase() : std.getMatricNo().toUpperCase()%></td>
                                </tr>
                                <tr>
                                    <th>Full Name</th>
                                    <td><%=std.getSurname().toUpperCase() + " " + std.getOthernames().toUpperCase()%></td>
                                </tr>
                                <tr>
                                    <th>Date of Birth</th>
                                    <td><%=std.getDateOfBirth()%></td>
                                </tr>
                                <tr>
                                    <th>Gender</th>
                                    <td><%=std.getGender()%></td>
                                </tr>
                                <tr>
                                    <th>Email Address</th>
                                    <td><%=std.getUniversityEmail()%></td>
                                </tr>
                                <%
                                    try {
                                %>
                                <tr>
                                    <th>State of Origin</th>
                                    <td><%=std.getStateOfOrigin().getName()%></td>
                                </tr>
                                <%
                                    } catch (Exception k) {
                                    }
                                %>

                            </tbody>
                        </table>
                        <%
                            } catch (Exception k) {
                            }


                        %>

                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed" type="button" data-coreui-toggle="collapse" data-coreui-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">Academic Details</button>
                </h2>
                <div class="accordion-collapse collapse" id="collapseTwo" aria-labelledby="headingTwo" data-coreui-parent="#accordionExample" style="">
                    <div class="accordion-body">
                        <%
                            try {
                        %>
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <th>Course of Study</th>
                                    <td><%=std.getCourseId().getName()%></td>
                                </tr>
                                <tr>
                                    <th>Department</th>
                                    <td><%=std.getCourseId().getDepartmentId().getName()%></td>
                                </tr>
                                 <tr>
                                    <th>Faculty</th>
                                    <td><%=std.getCourseId().getDepartmentId().getFacultyId().getName()%></td>
                                </tr>
                                <tr>
                                    <th>Programme</th>
                                    <td><%=std.getCourseId().getSchoolProgrammeId().getProgrammeId().getName()%></td>
                                </tr>
                                <tr>
                                    <th>School</th>
                                    <td><%=std.getCourseId().getSchoolProgrammeId().getSchoolId().getName()%></td>
                                </tr>
                                <tr>
                                    <th>Programme Duration</th>
                                    <td><%=std.getCourseId().getDefaultDuration()%> Semesters</td>
                                </tr>
                                <tr>
                                    <th>Current Level</th>
                                    <td><%=std.getCurrentClass()%></td>
                                </tr>
                                <tr>
                                    <th>Semesters Covered</th>
                                    <td><%=prograssion.size()%></td>
                                </tr>
                            </tbody>
                        </table>
                        <%
                            
                            } catch (Exception k) {
                            }
                        %>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed" type="button" data-coreui-toggle="collapse" data-coreui-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">Payment History</button>
                </h2>
                <div class="accordion-collapse collapse" id="collapseThree" aria-labelledby="headingThree" data-coreui-parent="#accordionExample" style="">
                    <div class="accordion-body">
                        <%
                            try {
                        %>
                        <table class="table table-striped table-hover">
                            <thead>
                            <th class="center">SNO</th>
                            <th>Payment Type</th>
                            <th>Session</th>
                            <th>Semester</th>
                            <th>Date Paid</th>
                            <th>Amount</th>
                            <th class="right">Download Receipt</th>
                            </thead>
                            <tbody>
                                <%
                                    List<Payments> payments = sess.getPaymentsByRegno(std.getId());
                                    int sn = 1;
                                    for (Payments pay : payments) {
                                %>
                                <tr>
                                    <td class="center"><%=sn%></td>
                                    <td><%=pay.getFeesGroupId().getName()%></td>
                                    <td><%=pay.getSessionPaid()%></td>
                                    <td><%=pay.getSemesterPaid()%></td>
                                    <td><%=settings.formatDate(pay.getDatePaid())%></td>
                                    <td class="right"><%=settings.formatno.format(pay.getAmount())%></td>
                                    <td><a href="/DownloadReceipt?id=<%=pay.getId()%>" target="_blank">Download</a></td>
                                </tr>
                                <%

                                        sn++;
                                    }
                                %>
                            </tbody>
                        </table>
                        <%
                            } catch (Exception k) {
                            }
                        %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>