    <management>
        <audit-log>
            <formatters>
                <json-formatter name="json-formatter" />
            </formatters>
            <handlers>
                <file-handler name="file" formatter="json-formatter" path="audit-log.log" relative-to="jboss.server.data.dir" />
            </handlers>
            <logger log-boot="true" log-read-only="false" enabled="false">
                <handlers>
                    <handler name="file" />
                </handlers>
            </logger>
        </audit-log>
        <management-interfaces>
            <http-interface http-authentication-factory="management-http-authentication">
                <http-upgrade enabled="true" sasl-authentication-factory="management-sasl-authentication" />
                <socket-binding http="management-http" />
            </http-interface>
        </management-interfaces>
        <access-control provider="simple">
            <role-mapping>
                <role name="SuperUser">
                    <include>
                        <user name="$local" />
                    </include>
                </role>
            </role-mapping>
        </access-control>
    </management>
    <profile>
        <ns1:subsystem>
            <ns1:console-handler name="CONSOLE">
                <ns1:level name="INFO" />
                <ns1:formatter>
                    <ns1:named-formatter name="COLOR-PATTERN" />
                </ns1:formatter>
            </ns1:console-handler>
            <ns1:periodic-rotating-file-handler name="FILE" autoflush="true">
                <ns1:formatter>
                    <ns1:named-formatter name="PATTERN" />
                </ns1:formatter>
                <ns1:file relative-to="jboss.server.log.dir" path="server.log" />
                <ns1:suffix value=".yyyy-MM-dd" />
                <ns1:append value="true" />
            </ns1:periodic-rotating-file-handler>
            <ns1:logger category="com.arjuna">
                <ns1:level name="WARN" />
            </ns1:logger>
            <ns1:logger category="com.networknt.schema">
                <ns1:level name="WARN" />
            </ns1:logger>
            <ns1:logger category="io.jaegertracing.Configuration">
                <ns1:level name="WARN" />
            </ns1:logger>
            <ns1:logger category="org.jboss.as.config">
                <ns1:level name="DEBUG" />
            </ns1:logger>
            <ns1:logger category="sun.rmi">
                <ns1:level name="WARN" />
            </ns1:logger>
            <ns1:root-logger>
                <ns1:level name="INFO" />
                <ns1:handlers>
                    <ns1:handler name="CONSOLE" />
                    <ns1:handler name="FILE" />
                </ns1:handlers>
            </ns1:root-logger>
            <ns1:formatter name="PATTERN">
                <ns1:pattern-formatter pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c] (%t) %s%e%n" />
            </ns1:formatter>
            <ns1:formatter name="COLOR-PATTERN">
                <ns1:pattern-formatter pattern="%K{level}%d{HH:mm:ss,SSS} %-5p [%c] (%t) %s%e%n" />
            </ns1:formatter>
        </ns1:subsystem>
        <ns2:subsystem>
            <ns2:default-job-repository name="in-memory" />
            <ns2:default-thread-pool name="batch" />
            <ns2:security-domain name="ApplicationDomain" />
            <ns2:job-repository name="in-memory">
                <ns2:in-memory />
            </ns2:job-repository>
            <ns2:thread-pool name="batch">
                <ns2:max-threads count="10" />
                <ns2:keepalive-time time="30" unit="seconds" />
            </ns2:thread-pool>
        </ns2:subsystem>
        <ns3:subsystem />
        <ns4:subsystem />
        <ns5:subsystem>
            <ns5:datasources>
                <ns5:datasource jndi-name="java:jboss/datasources/ExampleDS" pool-name="ExampleDS" enabled="true" use-java-context="true" statistics-enabled="${wildfly.datasources.statistics-enabled:${wildfly.statistics-enabled:false}}">
                    <ns5:connection-url>jdbc:h2:mem:test;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=${wildfly.h2.compatibility.mode:REGULAR}</ns5:connection-url>
                    <ns5:driver>h2</ns5:driver>
                    <ns5:security user-name="sa" password="sa" />
                </ns5:datasource>
                <ns5:datasource jndi-name="java:jboss/datasources/MariadbDS" pool-name="MariadbDS">
                    <ns5:connection-url>jdbc:mysql://localhost:3306/bsumpro</ns5:connection-url>
                    <ns5:driver>mariadb</ns5:driver>
                    <ns5:transaction-isolation>TRANSACTION_READ_COMMITTED</ns5:transaction-isolation>
                    <ns5:pool>
                        <ns5:min-pool-size>10</ns5:min-pool-size>
                        <ns5:max-pool-size>100</ns5:max-pool-size>
                        <ns5:prefill>true</ns5:prefill>
                    </ns5:pool>
                    <ns5:security user-name="root" password="29*New@10!" />
                    <ns5:statement>
                        <ns5:prepared-statement-cache-size>32</ns5:prepared-statement-cache-size>
                        <ns5:share-prepared-statements>true</ns5:share-prepared-statements>
                    </ns5:statement>
                </ns5:datasource>
                <ns5:datasource jndi-name="java:jboss/datasources/PostgresDS" pool-name="PostgresDS">
                    <ns5:connection-url>jdbc:postgresql://localhost:5432/bsuportaldb?search_path=public</ns5:connection-url>
                    <ns5:driver>postgresql</ns5:driver>
                    <ns5:transaction-isolation>TRANSACTION_READ_COMMITTED</ns5:transaction-isolation>
                    <ns5:pool>
                        <ns5:min-pool-size>40</ns5:min-pool-size>
                        <ns5:max-pool-size>400</ns5:max-pool-size>
                        <ns5:prefill>true</ns5:prefill>
                    </ns5:pool>
                    <ns5:security user-name="admin" password="Mybsu2022%" />
                    <ns5:statement>
                        <ns5:prepared-statement-cache-size>128</ns5:prepared-statement-cache-size>
                        <ns5:share-prepared-statements>true</ns5:share-prepared-statements>
                    </ns5:statement>
                </ns5:datasource>
                <ns5:drivers>
                    <ns5:driver name="h2" module="com.h2database.h2">
                        <ns5:xa-datasource-class>org.h2.jdbcx.JdbcDataSource</ns5:xa-datasource-class>
                    </ns5:driver>
                    <ns5:driver name="mariadb" module="org.mariadb">
                        <ns5:driver-class>org.mariadb.jdbc.Driver</ns5:driver-class>
                        <ns5:xa-datasource-class>org.mariadb.jdbc.MySQLDataSource</ns5:xa-datasource-class>
                    </ns5:driver>
                    <ns5:driver name="postgresql" module="org.postgresql">
                        <ns5:driver-class>org.postgresql.Driver</ns5:driver-class>
                    </ns5:driver>
                </ns5:drivers>
            </ns5:datasources>
        </ns5:subsystem>
        <ns6:subsystem>
            <ns6:deployment-scanner path="deployments" relative-to="jboss.server.base.dir" scan-interval="5000" runtime-failure-causes-rollback="${jboss.deployment.scanner.rollback.on.failure:false}" />
        </ns6:subsystem>
        <ns7:subsystem />
        <ns8:subsystem default-bean-management="default">
            <ns8:infinispan-bean-management name="default" max-active-beans="10000" cache-container="ejb" cache="passivation" />
            <ns8:local-client-mappings-registry />
            <ns8:infinispan-timer-management name="persistent" cache-container="ejb" cache="persistent" max-active-timers="10000" />
            <ns8:infinispan-timer-management name="transient" cache-container="ejb" cache="transient" max-active-timers="10000" />
        </ns8:subsystem>
        <ns9:subsystem default-session-management="default" default-single-sign-on-management="default">
            <ns9:infinispan-session-management name="default" cache-container="web" granularity="SESSION">
                <ns9:local-affinity />
            </ns9:infinispan-session-management>
            <ns9:infinispan-single-sign-on-management name="default" cache-container="web" cache="sso" />
            <ns9:local-routing />
        </ns9:subsystem>
        <ns10:subsystem>
            <ns10:spec-descriptor-property-replacement>false</ns10:spec-descriptor-property-replacement>
            <ns10:concurrent>
                <ns10:context-services>
                    <ns10:context-service name="default" jndi-name="java:jboss/ee/concurrency/context/default" />
                </ns10:context-services>
                <ns10:managed-thread-factories>
                    <ns10:managed-thread-factory name="default" jndi-name="java:jboss/ee/concurrency/factory/default" context-service="default" />
                </ns10:managed-thread-factories>
                <ns10:managed-executor-services>
                    <ns10:managed-executor-service name="default" jndi-name="java:jboss/ee/concurrency/executor/default" context-service="default" hung-task-termination-period="0" hung-task-threshold="60000" keepalive-time="5000" />
                </ns10:managed-executor-services>
                <ns10:managed-scheduled-executor-services>
                    <ns10:managed-scheduled-executor-service name="default" jndi-name="java:jboss/ee/concurrency/scheduler/default" context-service="default" hung-task-termination-period="0" hung-task-threshold="60000" keepalive-time="3000" />
                </ns10:managed-scheduled-executor-services>
            </ns10:concurrent>
            <ns10:default-bindings context-service="java:jboss/ee/concurrency/context/default" datasource="java:jboss/datasources/ExampleDS" managed-executor-service="java:jboss/ee/concurrency/executor/default" managed-scheduled-executor-service="java:jboss/ee/concurrency/scheduler/default" managed-thread-factory="java:jboss/ee/concurrency/factory/default" />
        </ns10:subsystem>
        <ns11:subsystem />
        <ns12:subsystem>
            <ns12:session-bean>
                <ns12:stateless>
                    <ns12:bean-instance-pool-ref pool-name="slsb-strict-max-pool" />
                </ns12:stateless>
                <ns12:stateful default-access-timeout="5000" cache-ref="simple" passivation-disabled-cache-ref="simple" />
                <ns12:singleton default-access-timeout="5000" />
            </ns12:session-bean>
            <ns12:pools>
                <ns12:bean-instance-pools>
                    <ns12:strict-max-pool name="slsb-strict-max-pool" derive-size="from-worker-pools" instance-acquisition-timeout="5" instance-acquisition-timeout-unit="MINUTES" />
                    <ns12:strict-max-pool name="mdb-strict-max-pool" derive-size="from-cpu-count" instance-acquisition-timeout="5" instance-acquisition-timeout-unit="MINUTES" />
                </ns12:bean-instance-pools>
            </ns12:pools>
            <ns12:caches>
                <ns12:simple-cache name="simple" />
                <ns12:distributable-cache name="distributable" />
            </ns12:caches>
            <ns12:async thread-pool-name="default" />
            <ns12:timer-service thread-pool-name="default" default-data-store="default-file-store">
                <ns12:data-stores>
                    <ns12:file-data-store name="default-file-store" path="timer-service-data" relative-to="jboss.server.data.dir" />
                </ns12:data-stores>
            </ns12:timer-service>
            <ns12:remote cluster="ejb" connectors="http-remoting-connector" thread-pool-name="default">
                <ns12:channel-creation-options>
                    <ns12:option name="MAX_OUTBOUND_MESSAGES" value="1234" type="remoting" />
                </ns12:channel-creation-options>
            </ns12:remote>
            <ns12:thread-pools>
                <ns12:thread-pool name="default">
                    <ns12:max-threads count="10" />
                    <ns12:keepalive-time time="60" unit="seconds" />
                </ns12:thread-pool>
            </ns12:thread-pools>
            <ns12:default-security-domain value="other" />
            <ns12:application-security-domains>
                <ns12:application-security-domain name="other" security-domain="ApplicationDomain" />
            </ns12:application-security-domains>
            <ns12:default-missing-method-permissions-deny-access value="true" />
            <ns12:statistics enabled="${wildfly.ejb3.statistics-enabled:${wildfly.statistics-enabled:false}}" />
            <ns12:log-system-exceptions value="true" />
        </ns12:subsystem>
        <ns13:subsystem final-providers="combined-providers" disallowed-providers="OracleUcrypto">
            <ns13:providers>
                <ns13:aggregate-providers name="combined-providers">
                    <ns13:providers name="elytron" />
                    <ns13:providers name="openssl" />
                </ns13:aggregate-providers>
                <ns13:provider-loader name="elytron" module="org.wildfly.security.elytron" />
                <ns13:provider-loader name="openssl" module="org.wildfly.openssl" />
            </ns13:providers>
            <ns13:audit-logging>
                <ns13:file-audit-log name="local-audit" path="audit.log" relative-to="jboss.server.log.dir" format="JSON" />
            </ns13:audit-logging>
            <ns13:security-domains>
                <ns13:security-domain name="ApplicationDomain" default-realm="ApplicationRealm" permission-mapper="default-permission-mapper">
                    <ns13:realm name="ApplicationRealm" role-decoder="groups-to-roles" />
                    <ns13:realm name="local" />
                </ns13:security-domain>
                <ns13:security-domain name="ManagementDomain" default-realm="ManagementRealm" permission-mapper="default-permission-mapper">
                    <ns13:realm name="ManagementRealm" role-decoder="groups-to-roles" />
                    <ns13:realm name="local" role-mapper="super-user-mapper" />
                </ns13:security-domain>
            </ns13:security-domains>
            <ns13:security-realms>
                <ns13:identity-realm name="local" identity="$local" />
                <ns13:properties-realm name="ApplicationRealm">
                    <ns13:users-properties path="application-users.properties" relative-to="jboss.server.config.dir" digest-realm-name="ApplicationRealm" />
                    <ns13:groups-properties path="application-roles.properties" relative-to="jboss.server.config.dir" />
                </ns13:properties-realm>
                <ns13:properties-realm name="ManagementRealm">
                    <ns13:users-properties path="mgmt-users.properties" relative-to="jboss.server.config.dir" digest-realm-name="ManagementRealm" />
                    <ns13:groups-properties path="mgmt-groups.properties" relative-to="jboss.server.config.dir" />
                </ns13:properties-realm>
            </ns13:security-realms>
            <ns13:mappers>
                <ns13:simple-permission-mapper name="default-permission-mapper" mapping-mode="first">
                    <ns13:permission-mapping>
                        <ns13:principal name="anonymous" />
                        <ns13:permission-set name="default-permissions" />
                    </ns13:permission-mapping>
                    <ns13:permission-mapping match-all="true">
                        <ns13:permission-set name="login-permission" />
                        <ns13:permission-set name="default-permissions" />
                    </ns13:permission-mapping>
                </ns13:simple-permission-mapper>
                <ns13:constant-realm-mapper name="local" realm-name="local" />
                <ns13:simple-role-decoder name="groups-to-roles" attribute="groups" />
                <ns13:constant-role-mapper name="super-user-mapper">
                    <ns13:role name="SuperUser" />
                </ns13:constant-role-mapper>
            </ns13:mappers>
            <ns13:permission-sets>
                <ns13:permission-set name="login-permission">
                    <ns13:permission class-name="org.wildfly.security.auth.permission.LoginPermission" />
                </ns13:permission-set>
                <ns13:permission-set name="default-permissions">
                    <ns13:permission class-name="org.wildfly.transaction.client.RemoteTransactionPermission" module="org.wildfly.transaction.client" />
                    <ns13:permission class-name="org.jboss.ejb.client.RemoteEJBPermission" module="org.jboss.ejb-client" />
                    <ns13:permission class-name="org.wildfly.extension.batch.jberet.deployment.BatchPermission" module="org.wildfly.extension.batch.jberet" target-name="*" />
                </ns13:permission-set>
            </ns13:permission-sets>
            <ns13:http>
                <ns13:http-authentication-factory name="application-http-authentication" security-domain="ApplicationDomain" http-server-mechanism-factory="global">
                    <ns13:mechanism-configuration>
                        <ns13:mechanism mechanism-name="BASIC">
                            <ns13:mechanism-realm realm-name="ApplicationRealm" />
                        </ns13:mechanism>
                    </ns13:mechanism-configuration>
                </ns13:http-authentication-factory>
                <ns13:http-authentication-factory name="management-http-authentication" security-domain="ManagementDomain" http-server-mechanism-factory="global">
                    <ns13:mechanism-configuration>
                        <ns13:mechanism mechanism-name="DIGEST">
                            <ns13:mechanism-realm realm-name="ManagementRealm" />
                        </ns13:mechanism>
                    </ns13:mechanism-configuration>
                </ns13:http-authentication-factory>
                <ns13:provider-http-server-mechanism-factory name="global" />
            </ns13:http>
            <ns13:sasl>
                <ns13:sasl-authentication-factory name="application-sasl-authentication" sasl-server-factory="configured" security-domain="ApplicationDomain">
                    <ns13:mechanism-configuration>
                        <ns13:mechanism mechanism-name="JBOSS-LOCAL-USER" realm-mapper="local" />
                        <ns13:mechanism mechanism-name="DIGEST-MD5">
                            <ns13:mechanism-realm realm-name="ApplicationRealm" />
                        </ns13:mechanism>
                    </ns13:mechanism-configuration>
                </ns13:sasl-authentication-factory>
                <ns13:sasl-authentication-factory name="management-sasl-authentication" sasl-server-factory="configured" security-domain="ManagementDomain">
                    <ns13:mechanism-configuration>
                        <ns13:mechanism mechanism-name="JBOSS-LOCAL-USER" realm-mapper="local" />
                        <ns13:mechanism mechanism-name="DIGEST-MD5">
                            <ns13:mechanism-realm realm-name="ManagementRealm" />
                        </ns13:mechanism>
                    </ns13:mechanism-configuration>
                </ns13:sasl-authentication-factory>
                <ns13:configurable-sasl-server-factory name="configured" sasl-server-factory="elytron">
                    <ns13:properties>
                        <ns13:property name="wildfly.sasl.local-user.default-user" value="$local" />
                        <ns13:property name="wildfly.sasl.local-user.challenge-path" value="${jboss.server.temp.dir}/auth" />
                    </ns13:properties>
                </ns13:configurable-sasl-server-factory>
                <ns13:mechanism-provider-filtering-sasl-server-factory name="elytron" sasl-server-factory="global">
                    <ns13:filters>
                        <ns13:filter provider-name="WildFlyElytron" />
                    </ns13:filters>
                </ns13:mechanism-provider-filtering-sasl-server-factory>
                <ns13:provider-sasl-server-factory name="global" />
            </ns13:sasl>
            <ns13:tls>
                <ns13:key-stores>
                    <ns13:key-store name="applicationKS">
                        <ns13:credential-reference clear-text="password" />
                        <ns13:implementation type="JKS" />
                        <ns13:file path="application.keystore" relative-to="jboss.server.config.dir" />
                    </ns13:key-store>
                </ns13:key-stores>
                <ns13:key-managers>
                    <ns13:key-manager name="applicationKM" key-store="applicationKS" generate-self-signed-certificate-host="localhost">
                        <ns13:credential-reference clear-text="password" />
                    </ns13:key-manager>
                </ns13:key-managers>
                <ns13:server-ssl-contexts>
                    <ns13:server-ssl-context name="applicationSSC" key-manager="applicationKM" />
                </ns13:server-ssl-contexts>
            </ns13:tls>
            <ns13:policy name="jacc">
                <ns13:jacc-policy />
            </ns13:policy>
        </ns13:subsystem>
        <ns14:subsystem />
        <ns15:subsystem security-enabled="false" />
        <ns16:subsystem>
            <ns16:cache-container name="hibernate" marshaller="JBOSS" modules="org.infinispan.hibernate-cache">
                <ns16:local-cache name="entity">
                    <ns16:heap-memory size="10000" />
                    <ns16:expiration max-idle="100000" />
                </ns16:local-cache>
                <ns16:local-cache name="local-query">
                    <ns16:heap-memory size="10000" />
                    <ns16:expiration max-idle="100000" />
                </ns16:local-cache>
                <ns16:local-cache name="timestamps">
                    <ns16:expiration interval="0" />
                </ns16:local-cache>
                <ns16:local-cache name="pending-puts">
